{
  "name": "@local/dsh-independent-auto-review",
  "version": "0.2.1",
  "private": true,
  "description": "Use and configure a separate model for DSH Auto Review. Keep the main model unchanged.",
  "type": "module",
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/QR-0W/dsh-independent-auto-review.git"},
  "homepage": "https://github.com/QR-0W/dsh-independent-auto-review#readme",
  "bugs": {"url": "https://github.com/QR-0W/dsh-independent-auto-review/issues"},
  "main": "./src/auto-review.js",
  "exports": {
    ".": "./src/auto-review.js",
    "./settings": "./tools/gui/host.js",
    "./client": "./tools/gui/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["src", "locale", "cordis.patch.yml", "LICENSE", "NOTICE.md", "README.md", "tools/gui/host.js", "tools/gui/domain.js", "tools/gui/service.js", "tools/gui/rpc.js", "tools/gui/client.js", "tools/gui/locale", "tools/gui/THIRD-PARTY-NOTICES.md"],
  "engines": {"node": ">=24"},
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.1",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.1",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.1",
    "zod": "4.6.7"
  },
  "scripts": {
    "link:runtime": "node ./tools/link-runtime.mjs",
    "test": "node --import ./test/register-host.mjs --test test/*.test.mjs",
    "build:gui": "node tools/gui/build.mjs",
    "check:gui": "node --check tools/gui/host.js && node --check tools/gui/rpc.js && node --check tools/gui/service.js && node --check tools/gui/client.js",
    "check": "node --check src/auto-review.js && node --check src/reviewer.js && npm run check:gui && npm test",
    "check:migration": "npm run check && node --import ./test/register-host.mjs --test test/cold-migration.acceptance.mjs",
    "test:live": "node --import ./test/register-host.mjs test/live-review.mjs"
  },
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"]}
  }
}
